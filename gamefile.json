{
  "name": "OVERLOAD",
  "deckBuilding": {
    "mainFilters": ["type", "cost", "color"],
    "formats": [
      { "title": "Classic", "gameplay": "Classic" }
    ]
  },
  "cardRotation": 90,
  "menuBackgroundImage": "https://overload-rulebook.netlify.app/assets/packaging_starter.png",
  "gameplay": {
    "Classic": {
      "mulligan": { 
        "startingHandSize": 4 
      },
      "newTurn": { 
        "drawOnStart": false,
        "sharedTurn": true,
        "drawPerTurn": 1 
      },
      "countersStartingValues": [],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            { "section": "Transcript" },
            {
              "direction": "row",
              "content": [
                { "section": "ENVSlot" },
                { "section": "PlayZone" }
              ]
            }
          ]
        },
        "sectionsDict": {
          "ENVSlot": { "isHidden": "no", "height": "SMALL", "alignment": "CENTER" },
          "PlayZone": { "isHidden": "yes", "height": "SMALL", "alignment": "CENTER" },
          "Transcript": { "isHidden": "no", "height": "SMALL", "alignment": "START" }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/GreenMangosLU/overload_tcg_arena/refs/heads/main/cards.json",
    "cardBack": "https://github.com/GreenMangosLU/overload_tcg_arena/blob/main/cardback.jpg?raw=true"
  }
}
